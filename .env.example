# =============================================================================
# BBVA VoC Analyzer - Plantilla de variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a `.env` (ignorado por git) y ajusta los valores.
# Cada variable corresponde a un campo de `voc_common.config.Settings`
# (sin distinguir mayúsculas). En Cloud Run las inyecta Pulumi (Épica 2).
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno y Proyecto GCP
# -----------------------------------------------------------------------------
# dev | staging | prod  (en prod se exige USER_HASH_SALT propio)
ENVIRONMENT=dev
# true: 1 Job maestro de Scheduler con ingesta secuencial de los 5 bancos
FREE_TIER_MODE=true
GCP_PROJECT_ID=bbva-voc-analyzer-dev
GCP_REGION=us-central1

# -----------------------------------------------------------------------------
# Almacenamiento (Cloud Storage Data Lake & Watermarks)
# -----------------------------------------------------------------------------
GCS_RAW_DATALAKE_BUCKET=voc-datalake-bbva-voc-analyzer-dev
# Checkpoints: gs://<bucket>/<prefix>/{bank_id}.json
GCS_WATERMARK_PREFIX=state/watermarks
# Staging efímero de reseñas crudas (pre-DLP)
GCS_RAW_STAGING_PREFIX=raw_staging

# -----------------------------------------------------------------------------
# BigQuery (Trusted Data Source - TDS)
# -----------------------------------------------------------------------------
BQ_DATASET_ID=bbva_voc_tds
BQ_SANITIZED_TDS_TABLE=sanitized_reviews_tds
BQ_PREDICTIONS_TABLE=delora_predictions
BQ_WATERMARKS_LOG_TABLE=ingestion_watermarks_log
BQ_HITL_AUDIT_TABLE=hitl_triage_audit_log

# -----------------------------------------------------------------------------
# Cloud Pub/Sub
# -----------------------------------------------------------------------------
PUBSUB_RAW_REVIEWS_TOPIC=voc-raw-reviews-topic
PUBSUB_RAW_SUBSCRIPTION=voc-raw-reviews-sub
PUBSUB_ALERTS_TOPIC=voc-incident-alerts-topic

# -----------------------------------------------------------------------------
# Cloud DLP (Ethics by Design)
# -----------------------------------------------------------------------------
# IDs completos de las plantillas (projects/<p>/locations/<r>/...Templates/<id>)
DLP_INSPECT_TEMPLATE_ID=
DLP_DEIDENTIFY_TEMPLATE_ID=
# Sal del hash SHA-256 de usuarios (mínimo 16 caracteres). NUNCA versionar la
# sal real; en prod se obtiene de Secret Manager / secrets de CI.
USER_HASH_SALT=dev-only-salt-override-in-prod

# -----------------------------------------------------------------------------
# Scraper Propio (batchexecute) y Anti-Throttling
# -----------------------------------------------------------------------------
# Proxies HTTP/SOCKS5 para rotación de IP. Acepta CSV o JSON; vacío = sin proxy.
#   SCRAPER_PROXY_POOL_URLS=http://p1:8080,socks5://p2:1080
#   SCRAPER_PROXY_POOL_URLS=["http://p1:8080","socks5://p2:1080"]
SCRAPER_PROXY_POOL_URLS=
SCRAPER_ROTATE_PROXY_EVERY_N_BATCHES=5
# Máximo nativo del RPC oCPfdb: 199
SCRAPER_PAGE_SIZE=199
# Pausa entre páginas = base + uniform(0, jitter)
SCRAPER_BASE_DELAY_SEC=1.5
SCRAPER_MAX_JITTER_SEC=2.0
SCRAPER_MAX_RETRIES=5
SCRAPER_TIMEOUT_SEC=30.0

# -----------------------------------------------------------------------------
# Parámetros MLOps y HITL
# -----------------------------------------------------------------------------
# Entropía (0..1) a partir de la cual una predicción va a revisión humana
HITL_ENTROPY_THRESHOLD=0.65
# false: búsqueda vectorial en BigQuery (sin costo de nodos Vertex en reposo)
ENABLE_DEDICATED_VERTEX_ENDPOINTS=false
