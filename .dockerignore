!services/ingestion-worker/src/
!services/sanitization-pipeline/pyproject.toml
!services/sanitization-pipeline/src/
!packages/voc-nlp/pyproject.toml
!packages/voc-nlp/src/
!services/ml-inference/pyproject.toml
!services/ml-inference/src/
!services/api-backend/pyproject.toml
!services/api-backend/src/
!web/portal/
!docs/analytics/labeling/annotation_guideline.md
!docs/analytics/eda/eda_aspects_guideline.md
web/portal/node_modules/
web/portal/dist/
**/__pycache__
**/*.pyc
